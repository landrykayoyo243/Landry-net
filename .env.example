# ============================================================
# LANDRY NET — Variables d'environnement
# Copier ce fichier en .env et remplir les vraies valeurs
# NE JAMAIS committer .env dans git !
# ============================================================

# --- Domaine officiel du site (SANS slash final) ---
# En production sur Vercel : renseigner cette variable avec le domaine réel
# Exemple : https://landryit.com
VITE_SITE_URL="https://landryit.com"

# --- Supabase (dashboard : supabase.com > Project Settings > API) ---
SUPABASE_URL="https://VOTRE_PROJECT_ID.supabase.co"
SUPABASE_PUBLISHABLE_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
SUPABASE_PROJECT_ID="VOTRE_PROJECT_ID"

# --- Supabase cote client (prefix VITE_ = expose dans le navigateur) ---
VITE_SUPABASE_URL="https://VOTRE_PROJECT_ID.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJ..."
VITE_SUPABASE_PROJECT_ID="VOTRE_PROJECT_ID"

# --- Base de donnees (pour les migrations) ---
LOVABLE_DB_MIGRATION_URL="postgresql://postgres.VOTRE_PROJECT_ID:MOT_DE_PASSE@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# --- Admin (compte administrateur du portfolio) ---
ADMIN_EMAIL="votre.email@gmail.com"
ADMIN_PASSWORD="MotDePasseAdmin!Fort123"

# --- Cloudinary (stockage images et CV PDF) ---
CLOUDINARY_CLOUD_NAME="votre_cloud_name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="votre_api_secret"
CLOUDINARY_FOLDER="Landry_Media"

# --- Cloudinary cote client ---
VITE_CLOUDINARY_CLOUD_NAME="votre_cloud_name"
VITE_CLOUDINARY_FOLDER="Landry_Media"

# --- SMTP Gmail (pour l'envoi d'emails depuis le formulaire de contact) ---
# Utiliser un "Mot de passe d'application" Gmail (pas le vrai mot de passe)
# Gmail > Securite > Validation en 2 etapes > Mots de passe d'application
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="votre.email@gmail.com"
SMTP_PASSWORD="xxxx xxxx xxxx xxxx"
SMTP_FROM="votre.email@gmail.com"
CONTACT_EMAIL="votre.email@gmail.com"

# --- Chiffrement maître AES-256-GCM (32 octets aléatoires = 64 caractères hex) ---
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

